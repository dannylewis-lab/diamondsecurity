# Database
DATABASE_URL="postgresql://user:password@localhost:5432/diamond_securities"

# Auth
JWT_SECRET="generate-a-long-random-secret-e.g.-openssl-rand-hex-64"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Administrator"

# DSE API Configuration
# Update these values based on your environment

# Base URLs for DSE APIs
DSE_MARKET_API=https://data.dse.co.tz
DSE_PRICES_API=https://dse.co.tz

# Data refresh intervals (in milliseconds)
NEXT_PUBLIC_MARKET_REFRESH_INTERVAL=30000
NEXT_PUBLIC_CHART_REFRESH_INTERVAL=60000

# Feature flags
NEXT_PUBLIC_ENABLE_REAL_TIME_DATA=true
NEXT_PUBLIC_ENABLE_HISTORICAL_CHARTS=true
